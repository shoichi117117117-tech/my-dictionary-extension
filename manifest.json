{
    "manifest_version": 3,
    "name": "Instant Word & Phrase Lookup",
    "version": "1.0.0",
    "description": "Highlight any text on web pages for instant definitions, translations, and audio pronunciation.",
    "permissions": [
      "activeTab",
      "storage"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "css": ["styles.css"]
      }
    ]
  }